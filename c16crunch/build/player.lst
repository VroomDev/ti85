000045r 1               update_monsters:
000045r 1  A9 00                lda #0
000047r 1  8D rr rr             sta mi                  ; steps
00004Ar 1  AD rr rr     @loop:  lda mi
00004Dr 1  C9 C8                cmp #SPOT_STEPS
00004Fr 1  90 01                bcc @raster
