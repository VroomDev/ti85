000000r 1               
000000r 1               init_sprites:
000000r 1  A9 00                lda #0
000002r 1  8D rr rr             sta spot
000005r 1  8D rr rr             sta spot+1
000008r 1  8D rr rr             sta game_over_flag
00000Br 1  8D rr rr             sta next_level_flag
00000Er 1  8D rr rr             sta hurt_dur
000011r 1  8D rr rr             sta bulletdir+1
000014r 1  8D rr rr             sta blt_left+1
000017r 1  8D rr rr             sta blt_cd+1
00001Ar 1  8D rr rr             sta move_cd+1
00001Dr 1  A2 00                ldx #0
00001Fr 1  20 rr rr             jsr init_one
000022r 1  AD rr rr             lda two_player
000025r 1  F0 05                beq @done
000027r 1  A2 01                ldx #1
000029r 1  20 rr rr             jsr init_one
00002Cr 1  60           @done:  rts
00002Dr 1               
00002Dr 1               ;; X = player slot
00002Dr 1               init_one:
00002Dr 1  8E rr rr             stx cur_pl
000030r 1  A9 00                lda #0
000032r 1  9D rr rr             sta bulletdir,x
000035r 1  9D rr rr             sta blt_left,x
000038r 1  9D rr rr             sta blt_cd,x
00003Br 1  9D rr rr             sta move_cd,x
00003Er 1  A9 04                lda #DIR_RIGHT
000040r 1  9D rr rr             sta pdir,x
000043r 1  E0 00                cpx #0
000045r 1  D0 0F                bne @p2
000047r 1  AD rr rr             lda player_at
00004Ar 1  8D rr rr             sta pxyl
00004Dr 1  AD rr rr             lda player_at+1
000050r 1  8D rr rr             sta pxyh
000053r 1  4C rr rr             jmp @put
000056r 1  AD rr rr     @p2:    lda player_at
000059r 1  18                   clc
00005Ar 1  69 01                adc #1
00005Cr 1  8D rr rr             sta pxyl+1
00005Fr 1  AD rr rr             lda player_at+1
000062r 1  69 00                adc #0
000064r 1  8D rr rr             sta pxyh+1
000067r 1  20 rr rr     @put:   jsr load_pxy
00006Ar 1  A9 62                lda #CHAR_PLAYER
00006Cr 1  4C rr rr             jmp map_set_cell
00006Fr 1               
00006Fr 1               inc_score:
00006Fr 1  F8                   sed
000070r 1  18                   clc
000071r 1  AD rr rr             lda score
000074r 1  69 01                adc #1
000076r 1  8D rr rr             sta score
000079r 1  AD rr rr             lda score+1
00007Cr 1  69 00                adc #0
00007Er 1  8D rr rr             sta score+1
000081r 1  D8                   cld
000082r 1  AD rr rr             lda score
000085r 1  C9 49                cmp #$49
000087r 1  F0 04                beq @life
000089r 1  C9 99                cmp #$99
00008Br 1  D0 0A                bne @chirp
00008Dr 1  AD rr rr     @life:  lda health
000090r 1  C9 09                cmp #9
000092r 1  B0 03                bcs @chirp
000094r 1  EE rr rr             inc health
000097r 1  4C rr rr     @chirp: jmp play_coin
00009Ar 1               
00009Ar 1               ;; A = direction. cell becomes (cell + delta) & 511.
00009Ar 1               ;; Up/down use PF_COLS. Left/right use 1.
00009Ar 1               add_dir:
00009Ar 1  C9 01                cmp #DIR_UP
00009Cr 1  D0 07                bne @down
00009Er 1  A9 E0                lda #<(-PF_COLS)
0000A0r 1  A2 FF                ldx #>(-PF_COLS)
0000A2r 1  4C rr rr             jmp @add
0000A5r 1  C9 02        @down:  cmp #DIR_DOWN
0000A7r 1  D0 07                bne @left
0000A9r 1  A9 20                lda #<PF_COLS
0000ABr 1  A2 00                ldx #0
0000ADr 1  4C rr rr             jmp @add
0000B0r 1  C9 03        @left:  cmp #DIR_LEFT
0000B2r 1  D0 07                bne @right
0000B4r 1  A9 FF                lda #<(-1)
0000B6r 1  A2 FF                ldx #>(-1)
0000B8r 1  4C rr rr             jmp @add
0000BBr 1  A9 01        @right: lda #<1
0000BDr 1  A2 00                ldx #0
0000BFr 1  18           @add:   clc
0000C0r 1  6D rr rr             adc cell
0000C3r 1  8D rr rr             sta cell
0000C6r 1  8A                   txa
0000C7r 1  6D rr rr             adc cell+1
0000CAr 1  29 01                and #((LEVEL_SIZE-1) >> 8)
0000CCr 1  8D rr rr             sta cell+1
0000CFr 1  60                   rts
0000D0r 1               
0000D0r 1               load_pxy:
0000D0r 1  AE rr rr             ldx cur_pl
0000D3r 1  BD rr rr             lda pxyl,x
0000D6r 1  8D rr rr             sta cell
0000D9r 1  BD rr rr             lda pxyh,x
0000DCr 1  8D rr rr             sta cell+1
0000DFr 1  60                   rts
0000E0r 1               
0000E0r 1               load_bxy:
0000E0r 1  AE rr rr             ldx cur_pl
0000E3r 1  BD rr rr             lda bxyl,x
0000E6r 1  8D rr rr             sta cell
0000E9r 1  BD rr rr             lda bxyh,x
0000ECr 1  8D rr rr             sta cell+1
0000EFr 1  60                   rts
0000F0r 1               
0000F0r 1               load_spot:
0000F0r 1  AD rr rr             lda spot
0000F3r 1  8D rr rr             sta cell
0000F6r 1  AD rr rr             lda spot+1
