00000Cr 1  xx xx        pxyh:           .res 2
00000Er 1  xx xx        bxyl:           .res 2
000010r 1  xx xx        bxyh:           .res 2
000012r 1  xx           cur_pl:         .res 1
000013r 1               ;; Shared
000013r 1  xx           hitxyval:       .res 1
000014r 1  xx           hurt_dur:       .res 1
000015r 1  xx           game_over_flag: .res 1
000016r 1  xx           next_level_flag:.res 1
