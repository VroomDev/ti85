000000r 1               ;; Per-player (.res 2), indexed by cur_pl
000000r 1  xx xx        pdir:           .res 2
000002r 1  xx xx        bulletdir:      .res 2
000004r 1  xx xx        move_cd:        .res 2
000006r 1  xx xx        blt_left:       .res 2
000008r 1  xx xx        blt_cd:         .res 2
