0000FCr 1  60                   rts
0000FDr 1               
0000FDr 1               save_pxy:
0000FDr 1  AE rr rr             ldx cur_pl
000100r 1  AD rr rr             lda cell
000103r 1  9D rr rr             sta pxyl,x
000106r 1  AD rr rr             lda cell+1
000109r 1  9D rr rr             sta pxyh,x
00010Cr 1  60                   rts
00010Dr 1               
00010Dr 1               save_bxy:
00010Dr 1  AE rr rr             ldx cur_pl
000110r 1  AD rr rr             lda cell
000113r 1  9D rr rr             sta bxyl,x
000116r 1  AD rr rr             lda cell+1
000119r 1  9D rr rr             sta bxyh,x
00011Cr 1  60                   rts
00011Dr 1               
00011Dr 1               ;; Stamp CHAR_PLAYER on every active player cell.
00011Dr 1               restamp_players:
00011Dr 1  AD rr rr             lda pxyl
000120r 1  8D rr rr             sta cell
000123r 1  AD rr rr             lda pxyh
000126r 1  8D rr rr             sta cell+1
000129r 1  A9 62                lda #CHAR_PLAYER
00012Br 1  20 rr rr             jsr map_set_cell
00012Er 1  AD rr rr             lda two_player
000131r 1  F0 11                beq @out
000133r 1  AD rr rr             lda pxyl+1
000136r 1  8D rr rr             sta cell
000139r 1  AD rr rr             lda pxyh+1
00013Cr 1  8D rr rr             sta cell+1
00013Fr 1  A9 62                lda #CHAR_PLAYER
000141r 1  20 rr rr             jsr map_set_cell
000144r 1  60           @out:   rts
000145r 1               
000145r 1               ;; C=1 if cell matches any live player position.
000145r 1               cell_is_player:
000145r 1  AD rr rr             lda cell
000148r 1  CD rr rr             cmp pxyl
00014Br 1  D0 08                bne @p2
00014Dr 1  AD rr rr             lda cell+1
000150r 1  CD rr rr             cmp pxyh
000153r 1  F0 15                beq @yes
000155r 1  AD rr rr     @p2:    lda two_player
000158r 1  F0 12                beq @no
00015Ar 1  AD rr rr             lda cell
00015Dr 1  CD rr rr             cmp pxyl+1
000160r 1  D0 0A                bne @no
000162r 1  AD rr rr             lda cell+1
000165r 1  CD rr rr             cmp pxyh+1
000168r 1  D0 02                bne @no
00016Ar 1  38           @yes:   sec
00016Br 1  60                   rts
00016Cr 1  18           @no:    clc
00016Dr 1  60                   rts
00016Er 1               
00016Er 1               ;; C=1 if bxy[cur_pl] matches any player (do not erase).
00016Er 1               bxy_on_player:
00016Er 1  AE rr rr             ldx cur_pl
000171r 1  BD rr rr             lda bxyl,x
000174r 1  8D rr rr             sta cell
000177r 1  BD rr rr             lda bxyh,x
00017Ar 1  8D rr rr             sta cell+1
00017Dr 1  4C rr rr             jmp cell_is_player
000180r 1               
000180r 1               ;; X = player slot on entry
000180r 1               update_player:
000180r 1  8E rr rr             stx cur_pl
000183r 1  E0 00                cpx #0
000185r 1  D0 08                bne @ready
000187r 1  AD rr rr             lda hurt_dur
00018Ar 1  F0 03                beq @ready
00018Cr 1  CE rr rr             dec hurt_dur
00018Fr 1  AE rr rr     @ready: ldx cur_pl
000192r 1  BD rr rr             lda input_bits,x
000195r 1  29 10                and #IN_FIRE
000197r 1  F0 03                beq @nof
000199r 1  20 rr rr             jsr do_fire
00019Cr 1  AE rr rr     @nof:   ldx cur_pl
00019Fr 1  BD rr rr             lda input_bits,x
0001A2r 1  29 0F                and #(IN_UP|IN_DOWN|IN_LEFT|IN_RIGHT)
0001A4r 1  D0 06                bne @has
0001A6r 1  A9 00                lda #0
0001A8r 1  9D rr rr             sta move_cd,x
0001ABr 1  60                   rts
0001ACr 1  BD rr rr     @has:   lda input_bits,x
0001AFr 1  29 01                and #IN_UP
0001B1r 1  F0 04                beq @1
0001B3r 1  A9 01                lda #DIR_UP
0001B5r 1  D0 18                bne @set
0001B7r 1  BD rr rr     @1:     lda input_bits,x
0001BAr 1  29 02                and #IN_DOWN
0001BCr 1  F0 04                beq @2
0001BEr 1  A9 02                lda #DIR_DOWN
0001C0r 1  D0 0D                bne @set
0001C2r 1  BD rr rr     @2:     lda input_bits,x
0001C5r 1  29 04                and #IN_LEFT
0001C7r 1  F0 04                beq @3
0001C9r 1  A9 03                lda #DIR_LEFT
0001CBr 1  D0 02                bne @set
0001CDr 1  A9 04        @3:     lda #DIR_RIGHT
0001CFr 1  AE rr rr     @set:   ldx cur_pl
0001D2r 1  9D rr rr             sta pdir,x
0001D5r 1  BD rr rr             lda input_bits,x
0001D8r 1  29 10                and #IN_FIRE
0001DAr 1  D0 09                bne @aim
0001DCr 1  BD rr rr             lda move_cd,x
0001DFr 1  F0 05                beq @go
0001E1r 1  DE rr rr             dec move_cd,x
0001E4r 1  60                   rts
0001E5r 1  60           @aim:   rts
0001E6r 1  A9 01        @go:    lda #MOVE_DELAY
0001E8r 1  9D rr rr             sta move_cd,x
0001EBr 1  20 rr rr             jsr load_pxy
0001EEr 1  A9 00                lda #CHAR_EMPTY
0001F0r 1  20 rr rr             jsr map_set_cell
0001F3r 1  AE rr rr             ldx cur_pl
0001F6r 1  BD rr rr             lda pdir,x
0001F9r 1  20 rr rr             jsr add_dir
0001FCr 1  20 rr rr             jsr map_get_cell
0001FFr 1  8D rr rr             sta hitxyval
000202r 1  C9 00                cmp #CHAR_EMPTY
000204r 1  F0 04                beq @step
000206r 1  C9 66                cmp #CHAR_BLOOD
000208r 1  D0 06                bne @blk
00020Ar 1  20 rr rr     @step:  jsr save_pxy
00020Dr 1  4C rr rr             jmp @redraw
000210r 1  C9 1B        @blk:   cmp #CHAR_COIN
000212r 1  D0 15                bne @redraw
000214r 1  20 rr rr             jsr inc_score
000217r 1  A9 00                lda #CHAR_EMPTY
000219r 1  20 rr rr             jsr map_set_cell
00021Cr 1  CE rr rr             dec coinsleft
00021Fr 1  D0 08                bne @redraw
000221r 1  20 rr rr             jsr bonus_alive
000224r 1  A9 01                lda #1
000226r 1  8D rr rr             sta next_level_flag
000229r 1               @redraw:
000229r 1  20 rr rr             jsr load_pxy
00022Cr 1  A9 62                lda #CHAR_PLAYER
00022Er 1  20 rr rr             jsr map_set_cell
000231r 1  60                   rts
000232r 1               
