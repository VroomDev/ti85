000000r 1               ;; Player / monsters / bullet on playfield[512]
000000r 1               ;; Per-player state is indexed by cur_pl (set from X on entry).
000000r 1               
000000r 1               .include "game.inc"
000000r 2               ;; Constants — SPEC.md
000000r 2               
000000r 2               .include "c16.inc"
000000r 3               ;; Stock 16KB Commodore 16 / TED. Screen $0C00, color $0800, charset RAM $2000.
000000r 3               
000000r 3               SCREEN      = $0C00
000000r 3               COLOR_RAM   = $0800
000000r 3               CHARSET     = $2000
000000r 3               
000000r 3               TED_KBD         = $FF08
000000r 3               KBD_LATCH       = $FD30
000000r 3               TED_V1LO        = $FF0E
000000r 3               TED_V2LO        = $FF0F
000000r 3               TED_V1HI        = $FF10
000000r 3               TED_SND         = $FF11
000000r 3               TED_CTRL        = $FF12
000000r 3               TED_CHAR        = $FF13
000000r 3               TED_BG          = $FF15
000000r 3               TED_BORDER      = $FF19
000000r 3               TED_CURSHI      = $FF0C
000000r 3               TED_CURSLO      = $FF0D
000000r 3               TED_RASTERHI    = $FF1C
000000r 3               TED_RASTERLO    = $FF1D
000000r 3               TED_ROMSEL      = $FF3E
000000r 3               
000000r 3               ;; $FF13 bits 7–2 = charset A15–A10. $2000 → bit 5. Bit 2 of $FF12 clear = RAM charset.
000000r 3               CHAR_BASE_RAM   = $20
000000r 3               
000000r 3               COLS        = 40
000000r 3               ROWS        = 25
000000r 3               PF_COLS     = 32
000000r 3               PF_ROWS     = 16
000000r 3               PF_X0       = 4
000000r 3               PF_Y0       = 4
000000r 3               PF_ORIGIN   = PF_Y0 * COLS + PF_X0
000000r 3               HUD_ROW     = 21
000000r 3               HUD_PAD     = 5             ; column of "S:"
000000r 3               HUD_ORIGIN  = HUD_ROW * COLS
000000r 3               ;; "vYYYYMMDD" (9) centered on the HUD row. First intro only.
000000r 3               VER_LEN     = 9
000000r 3               VER_ORIGIN  = HUD_ORIGIN + (COLS - VER_LEN) / 2
000000r 3               ;; "next" (4) centered on the 40×25 screen
000000r 3               NL_ORIGIN   = 12 * COLS + 18
000000r 3               ;; "pause" (5) centered on the 40×25 screen
000000r 3               PAUSE_ORIGIN = 12 * COLS + 17
000000r 3               ;; "PRESS 1 OR 2 TO START GAME" (26) centered on the last row
000000r 3               START_LEN   = 26
000000r 3               START_ORIGIN = 24 * COLS + (COLS - START_LEN) / 2
000000r 3               ;; Cheat "?" at column 0 of the last row
000000r 3               CHEAT_MARK  = 24 * COLS
000000r 3               ;; "HI:dddd" on the HUD row, after the level
000000r 3               HI_ORIGIN   = HUD_ORIGIN + 28
000000r 3               HI_LEN      = 7
000000r 3               
000000r 3               SPOT_STEPS        = 200
000000r 3               SPOT_STRIDE       = 183
000000r 3               RASTER_OFF_EARLY  = 123
000000r 3               RASTER_OFF        = 126
000000r 3               
000000r 3               ;; Plus/4 jiffy is $A3–$A5, $A5 least significant
000000r 3               JIFFY       = $A3
000000r 3               JIFFY_MID   = $A4
000000r 3               JIFFY_LO    = $A5
000000r 3               
000000r 3               ;; Editor cursor row. Parked off the 25-row screen.
000000r 3               CURS_Y      = $CD
000000r 3               CURS_X      = $CA
000000r 3               
000000r 2               
000000r 2               CHAR_EMPTY      = $00
000000r 2               CHAR_COIN       = $1B           ; two bitmaps, filled circle
000000r 2               CHAR_HEART      = $1C
000000r 2               CHAR_TREE       = $60
000000r 2               CHAR_BRICK      = $61
000000r 2               CHAR_PLAYER     = $62
000000r 2               CHAR_MONSTER    = $63           ; wander pic (blit alias)
000000r 2               CHAR_MONSTER1   = $64
000000r 2               CHAR_BULLET     = $65
000000r 2               CHAR_BLOOD      = $66
000000r 2               CHAR_WANDER_U   = $67
000000r 2               CHAR_WANDER_D   = $68
000000r 2               CHAR_WANDER_L   = $69
000000r 2               CHAR_WANDER_R   = $6A
000000r 2               
000000r 2               ;; TED color: bits 6–4 luminance, bits 3–0 chroma. Bit 7 is flash.
000000r 2               COL_BLACK       = $00
000000r 2               COL_WHITE       = $71
000000r 2               COL_RED         = $42
000000r 2               COL_CYAN        = $73
000000r 2               COL_PURPLE      = $54
000000r 2               COL_GREEN       = $55
000000r 2               COL_BLUE        = $66
000000r 2               COL_YELLOW      = $77
000000r 2               
000000r 2               DIR_UP          = 1
000000r 2               DIR_DOWN        = 2
000000r 2               DIR_LEFT        = 3
000000r 2               DIR_RIGHT       = 4
000000r 2               
000000r 2               IN_UP           = %00000001
000000r 2               IN_DOWN         = %00000010
000000r 2               IN_LEFT         = %00000100
000000r 2               IN_RIGHT        = %00001000
000000r 2               IN_FIRE         = %00010000
000000r 2               
000000r 2               LEVEL_SIZE      = 32 * 16
000000r 2               
000000r 2               MOVE_DELAY      = 1             ; countdown skips one frame → move every other frame
000000r 2               HURT_PERIOD     = 10            ; frames the player cannot be hurt again
000000r 2               BULLET_RANGE    = 4
000000r 2               BULLET_DELAY    = 0             ; step every frame
000000r 2               
000000r 2               MAZE_ROOMS      = 84            ; 14 × 6 odd cells in the centered 30×14 maze
000000r 2               LEVEL_CAP       = 99
000000r 2               
