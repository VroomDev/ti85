0002B4r 1  D0 03                bne @fly
0002B6r 1  4C rr rr             jmp stop_bullet
0002B9r 1               @fly:   ;; erase if was drawn (skip first cell = player start — bullet starts on player)
0002B9r 1  AD rr rr             lda bx
0002BCr 1  CD rr rr             cmp px
