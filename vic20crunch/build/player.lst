000000r 1               init_sprites:
000000r 1  A9 00                lda #0
000002r 1  8D rr rr             sta bulletdir
000005r 1  8D rr rr             sta blt_left
000008r 1  8D rr rr             sta blt_cd
00000Br 1  8D rr rr             sta spot
00000Er 1  8D rr rr             sta game_over_flag
000011r 1  8D rr rr             sta next_level_flag
000014r 1  8D rr rr             sta made
000017r 1  A9 04                lda #DIR_RIGHT
000019r 1  8D rr rr             sta pdir
00001Cr 1  A9 00                lda #0
00001Er 1  8D rr rr             sta move_cd
000021r 1               
000021r 1  AD rr rr             lda player_sx
000024r 1  8D rr rr             sta px
000027r 1  AD rr rr             lda player_sy
00002Ar 1  8D rr rr             sta py
00002Dr 1  A9 62                lda #CHAR_PLAYER
00002Fr 1  AE rr rr             ldx px
000032r 1  AC rr rr             ldy py
000035r 1  20 rr rr             jsr map_set
000038r 1  60                   rts
000039r 1               
000039r 1               ;; If spawn empty and made < level+2, stamp one there.
000039r 1               try_spawn:
000039r 1  AD rr rr             lda level
00003Cr 1  18                   clc
00003Dr 1  69 02                adc #2
00003Fr 1  CD rr rr             cmp made
000042r 1  F0 2C                beq @ret                ; made == level+2
000044r 1  90 2A                bcc @ret                ; made > level+2
000046r 1  AE rr rr             ldx monster_sx
000049r 1  AC rr rr             ldy monster_sy
00004Cr 1  20 rr rr             jsr map_get
00004Fr 1  C9 00                cmp #CHAR_EMPTY
000051r 1  D0 1D                bne @ret
000053r 1  AD rr rr             lda made
000056r 1  29 01                and #1
000058r 1  F0 08                beq @p1
00005Ar 1  20 rr rr             jsr rand_dir
00005Dr 1  18                   clc
00005Er 1  69 66                adc #CHAR_WANDER_U-1    ; 1..4 → $67..$6A
000060r 1  D0 02                bne @put
000062r 1  A9 64        @p1:    lda #CHAR_MONSTER1
000064r 1  AE rr rr     @put:   ldx monster_sx
000067r 1  AC rr rr             ldy monster_sy
00006Ar 1  20 rr rr             jsr map_set
00006Dr 1  EE rr rr             inc made
000070r 1  60           @ret:   rts
000071r 1               
000071r 1               ;===========================================================================
000071r 1               inc_score:
000071r 1  F8                   sed
000072r 1  18                   clc
000073r 1  AD rr rr             lda score
000076r 1  69 01                adc #1
000078r 1  8D rr rr             sta score
00007Br 1  AD rr rr             lda score+1
00007Er 1  69 00                adc #0
000080r 1  8D rr rr             sta score+1
000083r 1  D8                   cld
000084r 1  AD rr rr             lda score
000087r 1  C9 99                cmp #$99
000089r 1  D0 03                bne :+
00008Br 1  EE rr rr             inc health
00008Er 1               :
00008Er 1  4C rr rr             jmp play_coin
000091r 1               
000091r 1               ;; Last coin: +2 (two chirps) for each remaining monster.
000091r 1               bonus_alive:
000091r 1  A2 00                ldx #0
000093r 1  BD rr rr     @lp:    lda playfield,x
000096r 1  C9 64                cmp #CHAR_MONSTER1
000098r 1  F0 05                beq @hit
00009Ar 1  20 rr rr             jsr is_wander
00009Dr 1  90 15                bcc @n
00009Fr 1  A9 00        @hit:   lda #CHAR_EMPTY
0000A1r 1  9D rr rr             sta playfield,x
0000A4r 1  8A                   txa
0000A5r 1  48                   pha
0000A6r 1  20 rr rr             jsr inc_score
0000A9r 1  20 rr rr             jsr bonus_wait
0000ACr 1  20 rr rr             jsr inc_score
0000AFr 1  20 rr rr             jsr bonus_wait
0000B2r 1  68                   pla
0000B3r 1  AA                   tax
0000B4r 1  E8           @n:     inx
0000B5r 1  10 DC                bpl @lp
0000B7r 1  60                   rts
0000B8r 1               
0000B8r 1               ;===========================================================================
0000B8r 1               ;; Probe dest for dir A from (tx,ty). Sets hit_*; C=0 if empty (tx,ty updated).
0000B8r 1               probe:
0000B8r 1  8D rr rr             sta tdir
0000BBr 1  AD rr rr             lda tx
0000BEr 1  AE rr rr             ldx ty
0000C1r 1                       ;; X=col Y=row for map_get
0000C1r 1  AA                   tax
0000C2r 1  AC rr rr             ldy ty
0000C5r 1  AD rr rr             lda tdir
0000C8r 1  C9 01                cmp #DIR_UP
0000CAr 1  D0 08                bne @d
0000CCr 1  C0 00                cpy #0
0000CEr 1  F0 45                beq @wall
0000D0r 1  88                   dey
0000D1r 1  4C rr rr             jmp @cell
0000D4r 1  C9 02        @d:     cmp #DIR_DOWN
0000D6r 1  D0 08                bne @l
0000D8r 1  C0 07                cpy #(PF_ROWS-1)
0000DAr 1  F0 39                beq @wall
0000DCr 1  C8                   iny
0000DDr 1  4C rr rr             jmp @cell
0000E0r 1  C9 03        @l:     cmp #DIR_LEFT
0000E2r 1  D0 08                bne @r
0000E4r 1  E0 00                cpx #0
0000E6r 1  F0 2D                beq @wall
0000E8r 1  CA                   dex
0000E9r 1  4C rr rr             jmp @cell
0000ECr 1  C9 04        @r:     cmp #DIR_RIGHT
0000EEr 1  D0 25                bne @wall
0000F0r 1  E0 0F                cpx #(PF_COLS-1)
0000F2r 1  F0 21                beq @wall
0000F4r 1  E8                   inx
0000F5r 1  8E rr rr     @cell:  stx hit_x
0000F8r 1  8C rr rr             sty hit_y
0000FBr 1  20 rr rr             jsr map_get             ; X becomes index — do not store it as col
0000FEr 1  8D rr rr             sta hitxyval
000101r 1  C9 00                cmp #CHAR_EMPTY
000103r 1  D0 0E                bne @block
000105r 1  AD rr rr             lda hit_x
000108r 1  8D rr rr             sta tx
00010Br 1  AD rr rr             lda hit_y
00010Er 1  8D rr rr             sta ty
000111r 1  18                   clc
000112r 1  60                   rts
000113r 1  38           @block: sec
000114r 1  60                   rts
000115r 1  A9 01        @wall:  lda #1
000117r 1  8D rr rr             sta hitxyval
00011Ar 1  38                   sec
00011Br 1  60                   rts
