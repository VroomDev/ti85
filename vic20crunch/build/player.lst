000189r 1  AD rr rr             lda pdir
00018Cr 1  20 rr rr             jsr probe
00018Fr 1  90 25                bcc @moved
000191r 1                       ;; blocked — maybe coin (CRUNCH: score + erase, stay put)
000191r 1  AD rr rr             lda hitxyval
000194r 1  C9 1B                cmp #CHAR_COIN
000196r 1  D0 2A                bne @redraw
000198r 1  20 rr rr             jsr inc_score
00019Br 1  A9 00                lda #CHAR_EMPTY
00019Dr 1  AE rr rr             ldx hit_x
0001A0r 1  AC rr rr             ldy hit_y
