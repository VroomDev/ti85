000000r 3               ;; Unexpanded VIC-20 — see SPEC.md
000000r 3               ;;
000000r 3               ;; $1001 stub / code … $1800 font $00–$3F … $1A00 CODE2 … $1B00 tiles … $1C00 maps … $1E00 screen
000000r 3               ;; Color $9600. Leave $9002 bit 7 set.
000000r 3               
000000r 3               SCREEN      = $1E00
000000r 3               COLOR_RAM   = $9600
000000r 3               CHARSET     = $1800
000000r 3               
000000r 3               VIC         = $9000
000000r 3               VIC_CR2     = VIC+$2
000000r 3               VIC_HLINE   = VIC+$4
000000r 3               VIC_CR5     = VIC+$5
000000r 3               VIC_NOISE   = VIC+$D
000000r 3               VIC_COLOR   = VIC+$F
000000r 3               
000000r 3               ;; screen $1E00 + charset $1800 (stock bit7 of $9002 stays set)
000000r 3               VIC_CR5_GAME = $FE
000000r 3               
000000r 3               COLS        = 22
000000r 3               ROWS        = 23
000000r 3               PF_COLS     = 16
000000r 3               PF_ROWS     = 8
000000r 3               PF_X0       = 3
000000r 3               PF_Y0       = 6
000000r 3               PF_ORIGIN   = PF_Y0 * COLS + PF_X0
000000r 3               HUD_ROW     = 16
000000r 3               HUD_PAD     = 4                 ; S: line indent
000000r 3               HUD_ORIGIN  = HUD_ROW * COLS
000000r 3               ;; "next" (4 chars) centered
000000r 3               NL_ORIGIN   = 11 * COLS + 9
000000r 3               ;; "done" centered on second-to-last row
000000r 3               GO_ORIGIN   = 21 * COLS + 9
000000r 3               ;; "HI:dddd" on 3rd line, indent 5
000000r 3               HI_ORIGIN   = 2 * COLS + 7
000000r 3               HI_LEN      = 7
000000r 3               SPOT_STEPS  = 10
000000r 3               SPOT_STRIDE = 11
000000r 3               
000000r 3               CURS_FLAG   = $CC
000000r 3               JIFFY       = $A0
000000r 3               JIFFY_MID   = $A1
000000r 3               JIFFY_LO    = $A2
000000r 3               
000000r 2               
000000r 2               CHAR_EMPTY      = $00
000000r 2               CHAR_COIN       = $1B           ; PETSCII 113 (●), ROM $51 copied over [
000000r 2               CHAR_HEART      = $1C           ; ROM ♥ copied over £
000000r 2               CHAR_TREE       = $60
000000r 2               CHAR_BRICK      = $61
000000r 2               CHAR_PLAYER     = $62
000000r 2               CHAR_MONSTER    = $63           ; wander pic (blit alias)
000000r 2               CHAR_MONSTER1   = $64
000000r 2               CHAR_BULLET     = $65
000000r 2               CHAR_BLOOD      = $66
000000r 2               CHAR_WANDER_U   = $67           ; type 0 facing: up / down / left / right
000000r 2               CHAR_WANDER_D   = $68
000000r 2               CHAR_WANDER_L   = $69
000000r 2               CHAR_WANDER_R   = $6A
000000r 2               
000000r 2               COL_BLACK       = 0
000000r 2               COL_WHITE       = 1
000000r 2               COL_RED         = 2
000000r 2               COL_CYAN        = 3
000000r 2               COL_PURPLE      = 4
000000r 2               COL_GREEN       = 5
000000r 2               COL_BLUE        = 6
000000r 2               COL_YELLOW      = 7
000000r 2               
000000r 2               ;; Facing (matches TI movespr dir style 1..4)
000000r 2               DIR_UP          = 1
000000r 2               DIR_DOWN        = 2
000000r 2               DIR_LEFT        = 3
000000r 2               DIR_RIGHT       = 4
000000r 2               
000000r 2               IN_UP           = %00000001
000000r 2               IN_DOWN         = %00000010
000000r 2               IN_LEFT         = %00000100
000000r 2               IN_RIGHT        = %00001000
000000r 2               IN_FIRE         = %00010000
000000r 2               
000000r 2               LEVEL_SIZE      = 16 * 8
000000r 2               LEVEL_AND       = 7
000000r 2               MONSTER_MAX     = 21
000000r 2               
000000r 2               ;; Z80 was $0700 tight loops; NTSC VBlank playtest → 12 frames (~5 Hz)
000000r 2               FRAME_GATE      = 12
000000r 2               
000000r 2               MOVE_DELAY      = 4
000000r 2               BULLET_RANGE    = 3
000000r 2               BULLET_DELAY    = 4
