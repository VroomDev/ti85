0002F6r 1  F0 04                beq @blast
0002F8r 1  C9 66                cmp #CHAR_BLOOD
0002FAr 1  D0 3A                bne stop_bullet
0002FCr 1  A9 00        @blast: lda #CHAR_EMPTY
0002FEr 1  AE rr rr             ldx hit_x
000301r 1  AC rr rr             ldy hit_y
000304r 1  20 rr rr             jsr map_set
000307r 1  4C rr rr             jmp stop_bullet
00030Ar 1               @bmoved:
00030Ar 1  AD rr rr             lda tx
00030Dr 1  8D rr rr             sta bx
000310r 1  AD rr rr             lda ty
000313r 1  8D rr rr             sta by
000316r 1  A9 65                lda #CHAR_BULLET
000318r 1  AE rr rr             ldx bx
00031Br 1  AC rr rr             ldy by
00031Er 1  20 rr rr             jsr map_set
000321r 1  CE rr rr             dec blt_left
000324r 1                       ;; CRUNCH drawplayer after bullet move
000324r 1  A9 62                lda #CHAR_PLAYER
000326r 1  AE rr rr             ldx px
000329r 1  AC rr rr             ldy py
00032Cr 1  20 rr rr             jsr map_set
00032Fr 1  60                   rts
000330r 1  20 rr rr     @kill:  jsr damage_at_hit
000333r 1  4C rr rr             jmp stop_bullet
000336r 1               
000336r 1               stop_bullet:
000336r 1  AD rr rr             lda bx
000339r 1  CD rr rr             cmp px
00033Cr 1  D0 08                bne @er
00033Er 1  AD rr rr             lda by
000341r 1  CD rr rr             cmp py
000344r 1  F0 0B                beq @clr
000346r 1  A9 00        @er:    lda #CHAR_EMPTY
000348r 1  AE rr rr             ldx bx
00034Br 1  AC rr rr             ldy by
00034Er 1  20 rr rr             jsr map_set
000351r 1  A9 00        @clr:   lda #0
000353r 1  8D rr rr             sta bulletdir
000356r 1  A9 62                lda #CHAR_PLAYER
000358r 1  AE rr rr             ldx px
00035Br 1  AC rr rr             ldy py
00035Er 1  20 rr rr             jsr map_set
000361r 1  60                   rts
000362r 1               
000362r 1               ;; Board-only HP: wander → chase; chase → blood
000362r 1               damage_at_hit:
000362r 1  AD rr rr             lda hitxyval
000365r 1  20 rr rr             jsr is_wander
000368r 1  90 0C                bcc @kill
00036Ar 1  A9 64                lda #CHAR_MONSTER1
00036Cr 1  AE rr rr             ldx hit_x
00036Fr 1  AC rr rr             ldy hit_y
000372r 1  20 rr rr             jsr map_set
000375r 1  60                   rts
000376r 1  20 rr rr     @kill:  jsr play_kill
000379r 1  A9 66                lda #CHAR_BLOOD
00037Br 1  AE rr rr             ldx hit_x
00037Er 1  AC rr rr             ldy hit_y
000381r 1  20 rr rr             jsr map_set
000384r 1  60                   rts
000385r 1               
000385r 1               .segment "CODE2"
000000r 1               
000000r 1               bonus_wait:
000000r 1  A0 0C                ldy #12
000002r 1  98           @w:     tya
000003r 1  48                   pha
000004r 1  20 rr rr             jsr wait_vrefresh
000007r 1  20 rr rr             jsr blit_playfield
00000Ar 1  20 rr rr             jsr update_hud
00000Dr 1  20 rr rr             jsr play_audio_frame
000010r 1  68                   pla
000011r 1  A8                   tay
000012r 1  88                   dey
000013r 1  D0 ED                bne @w
000015r 1  60                   rts
000016r 1               
000016r 1               ;===========================================================================
000016r 1               ;; Mix randvar with VIC raster ($9004) and noise ($900D)
000016r 1               rand:
000016r 1  AD rr rr             lda randvar
000019r 1  0A                   asl a
00001Ar 1  69 0D                adc #13
00001Cr 1  20 rr rr             jsr mix_entropy
00001Fr 1  8D rr rr             sta randvar
000022r 1  60                   rts
000023r 1               
000023r 1               ;; CRUNCH: rand>>2 &3 +1 → facing 1..4
000023r 1               rand_dir:
000023r 1  20 rr rr             jsr rand
000026r 1  4A                   lsr a
000027r 1  4A                   lsr a
000028r 1  29 03                and #3
00002Ar 1  18                   clc
00002Br 1  69 01                adc #1
00002Dr 1  60                   rts
00002Er 1               
00002Er 1               spot_xy:
00002Er 1  AD rr rr             lda spot
000031r 1  29 0F                and #15
000033r 1  8D rr rr             sta tx
000036r 1  AA                   tax
000037r 1  AD rr rr             lda spot
00003Ar 1  4A                   lsr a
00003Br 1  4A                   lsr a
00003Cr 1  4A                   lsr a
00003Dr 1  4A                   lsr a
00003Er 1  8D rr rr             sta ty
000041r 1  A8                   tay
000042r 1  60                   rts
000043r 1               
000043r 1               type1_dir:
000043r 1  AD rr rr             lda coinsleft
000046r 1  CD rr rr             cmp level
000049r 1  F0 02                beq @jiffy
00004Br 1  B0 D6                bcs rand_dir            ; coinsleft > level → random
00004Dr 1  A5 A2        @jiffy: lda JIFFY_LO
00004Fr 1  29 10                and #16
000051r 1  D0 D0                bne rand_dir            ; ($A2 & 16) ≠ 0 → random
000053r 1  4C rr rr             jmp chase_player
000056r 1               
000056r 1               ;; A = cardinal toward player from (tx,ty). Longer axis, horiz on tie.
000056r 1               chase_player:
000056r 1  AD rr rr             lda px
000059r 1  CD rr rr             cmp tx
00005Cr 1  B0 0E                bcs @dxpos
00005Er 1  AD rr rr             lda tx
000061r 1  38                   sec
000062r 1  ED rr rr             sbc px
000065r 1  8D rr rr             sta tdir
000068r 1  A0 03                ldy #DIR_LEFT
00006Ar 1  D0 08                bne @dy
00006Cr 1  ED rr rr     @dxpos: sbc tx
00006Fr 1  8D rr rr             sta tdir
000072r 1  A0 04                ldy #DIR_RIGHT
000074r 1  AD rr rr     @dy:    lda py
000077r 1  CD rr rr             cmp ty
00007Ar 1  B0 11                bcs @dypos
00007Cr 1  AD rr rr             lda ty
00007Fr 1  38                   sec
000080r 1  ED rr rr             sbc py
000083r 1  CD rr rr             cmp tdir
000086r 1  90 12                bcc @horiz
000088r 1  F0 10                beq @horiz
00008Ar 1  A9 01                lda #DIR_UP
00008Cr 1  60                   rts
00008Dr 1  ED rr rr     @dypos: sbc ty
000090r 1  CD rr rr             cmp tdir
000093r 1  90 05                bcc @horiz
000095r 1  F0 03                beq @horiz
000097r 1  A9 02                lda #DIR_DOWN
000099r 1  60                   rts
00009Ar 1  98           @horiz: tya
00009Br 1  60                   rts
00009Cr 1               
00009Cr 1               .segment "CODE4"
000000r 1               
000000r 1               mix_entropy:
000000r 1  6D 04 90             adc VIC_HLINE           ; $9004 raster
000003r 1  6D 0D 90             adc VIC_NOISE           ; $900D noise
000006r 1  60                   rts
000007r 1               
000007r 1               .segment "CODE3"
000000r 1               
000000r 1               ;; C=1 if A is wander $67–$6A (A preserved)
000000r 1               is_wander:
000000r 1  C9 6B                cmp #CHAR_WANDER_R+1
000002r 1  B0 03                bcs @no
000004r 1  C9 67                cmp #CHAR_WANDER_U
000006r 1  60                   rts
000007r 1  18           @no:    clc
000008r 1  60                   rts
000008r 1               
