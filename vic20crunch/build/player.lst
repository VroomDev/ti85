00011Cr 1               ;===========================================================================
00011Cr 1               update_player:
00011Cr 1  20 rr rr             jsr read_input
00011Fr 1  AD rr rr             lda input_bits
000122r 1  29 10                and #IN_FIRE
000124r 1  F0 03                beq @nof
000126r 1  20 rr rr             jsr do_fire
000129r 1  AD rr rr     @nof:   lda input_bits
00012Cr 1  29 0F                and #(IN_UP|IN_DOWN|IN_LEFT|IN_RIGHT)
00012Er 1  D0 06                bne @has
000130r 1  A9 00                lda #0
000132r 1  8D rr rr             sta move_cd
000135r 1  60                   rts
000136r 1  AD rr rr     @has:   lda input_bits
000139r 1  29 01                and #IN_UP
00013Br 1  F0 04                beq @1
00013Dr 1  A9 01                lda #DIR_UP
00013Fr 1  D0 18                bne @set
000141r 1  AD rr rr     @1:     lda input_bits
000144r 1  29 02                and #IN_DOWN
000146r 1  F0 04                beq @2
000148r 1  A9 02                lda #DIR_DOWN
00014Ar 1  D0 0D                bne @set
00014Cr 1  AD rr rr     @2:     lda input_bits
00014Fr 1  29 04                and #IN_LEFT
000151r 1  F0 04                beq @3
000153r 1  A9 03                lda #DIR_LEFT
000155r 1  D0 02                bne @set
000157r 1  A9 04        @3:     lda #DIR_RIGHT
000159r 1  8D rr rr     @set:   sta pdir
00015Cr 1  AD rr rr             lda input_bits
00015Fr 1  29 10                and #IN_FIRE
000161r 1  D0 09                bne @aim                ; fire: face that way, do not walk
000163r 1  AD rr rr             lda move_cd
000166r 1  F0 05                beq @go
000168r 1  CE rr rr             dec move_cd
00016Br 1  60                   rts
00016Cr 1  60           @aim:   rts
00016Dr 1  A9 04        @go:    lda #MOVE_DELAY
00016Fr 1  8D rr rr             sta move_cd
000172r 1               
000172r 1                       ;; erase player
000172r 1  A9 00                lda #CHAR_EMPTY
000174r 1  AE rr rr             ldx px
000177r 1  AC rr rr             ldy py
00017Ar 1  20 rr rr             jsr map_set
00017Dr 1               
00017Dr 1  AD rr rr             lda px
000180r 1  8D rr rr             sta tx
