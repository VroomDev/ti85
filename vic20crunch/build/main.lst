000029r 1  D0 F5                bne :--
00002Br 1  60                   rts
00002Cr 1               
00002Cr 1               .macpack cbm
00002Cr 2               ; Convert characters to screen codes
00002Cr 2               
00002Cr 2               ; Macro that converts one character.
00002Cr 2               ; scrbyte() can be used as an instruction operand
00002Cr 2               .define scrbyte(code)   (<(.strat ("h@dbdlhh", code >> 5) << 4) ^ code)
00002Cr 2               
00002Cr 2               ; Helper macro that stores one character
00002Cr 2               .macro _scrcode char
00002Cr 2                       .if (char < 256)
00002Cr 2                               .byte   scrbyte {char}
00002Cr 2                       .else
00002Cr 2                               .error  "scrcode: Character constant out of range"
00002Cr 2                       .endif
00002Cr 2               .endmacro
00002Cr 2               
00002Cr 2               .macro  scrcode arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9
00002Cr 2               
00002Cr 2                       ; Bail out if next argument is empty
00002Cr 2                       .if     .blank ({arg1})
00002Cr 2                               .exitmacro
00002Cr 2                       .endif
00002Cr 2               
00002Cr 2                       ; Check for a string
00002Cr 2                       .if     .match ({arg1}, "")
00002Cr 2               
00002Cr 2                               ; Walk over all string chars
00002Cr 2                               .repeat .strlen (arg1), i
00002Cr 2                                       _scrcode        {.strat (arg1, i)}
00002Cr 2                               .endrepeat
00002Cr 2               
00002Cr 2                       ; Check for a number
00002Cr 2                       .elseif .match (.left (1, {arg1}), 0)
00002Cr 2               
00002Cr 2                               ; Just output the number
00002Cr 2                               _scrcode        arg1
00002Cr 2               
00002Cr 2                       ; Check for a character
00002Cr 2                       .elseif .match (.left (1, {arg1}), 'a')
00002Cr 2               
00002Cr 2                               ; Just output the character
00002Cr 2                               _scrcode        arg1
00002Cr 2               
00002Cr 2                       ; Check for an identifier
00002Cr 2                       .elseif .match (.left (1, {arg1}), identifier)
00002Cr 2               
00002Cr 2                               ; Just output the identifier
00002Cr 2                               _scrcode        arg1
00002Cr 2               
00002Cr 2                       ; Anything else is an error
00002Cr 2                       .else
00002Cr 2                               .error  "scrcode: invalid argument type"
00002Cr 2                       .endif
00002Cr 2               
00002Cr 2                       ; Call the macro recursively with the remaining args
00002Cr 2                       scrcode arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9
00002Cr 2               .endmacro
00002Cr 2               
00002Cr 1               ;; CRUNCH.ASM title — PETSCII uppercase letters = screen codes $01+
00002Cr 1               title:
00002Cr 1                       ;        0123456789012345678901
00002Cr 1  03 12 15 0E          scrcode "crunch (c)1996 chris b"
