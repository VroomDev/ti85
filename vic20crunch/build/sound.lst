000000r 1               
000000r 1               .export silence_vic
000000r 1               .export play_audio_frame
000000r 1               .export play_coin
000000r 1               .export play_kill
000000r 1               .export play_hurt
000000r 1               .export sfx_dur
000000r 1               
000000r 1               VIC_BASS        = $900A
000000r 1               VIC_ALTO        = $900B
000000r 1               VIC_SOPRANO     = $900C
000000r 1               VIC_VOLUME      = $900E
000000r 1               
000000r 1               .segment "ZEROPAGE"
000000r 1  xx           sfx_dur:        .res 1
000001r 1               
000001r 1               .segment "CODE"
000000r 1               
000000r 1               silence_vic:
000000r 1  A9 00                lda #0
000002r 1  8D 0A 90             sta VIC_BASS
000005r 1  8D 0B 90             sta VIC_ALTO
000008r 1  8D 0C 90             sta VIC_SOPRANO
00000Br 1  8D 0D 90             sta VIC_NOISE
00000Er 1  8D 0E 90             sta VIC_VOLUME
000011r 1  85 rr                sta sfx_dur
000013r 1  60                   rts
000014r 1               
000014r 1               
000014r 1               .segment "SFXCODE"
000000r 1               
000000r 1               play_coin:
000000r 1  A9 0F                lda #$0f
000002r 1  8D 0E 90             sta VIC_VOLUME
000005r 1  A9 F0                lda #240
000007r 1  8D 0C 90             sta VIC_SOPRANO
00000Ar 1                       ;lda #228
00000Ar 1  8D 0B 90             sta VIC_ALTO
00000Dr 1  A9 04                lda #4
00000Fr 1  85 rr                sta sfx_dur
000011r 1  60                   rts
000012r 1               
000012r 1               play_kill:
000012r 1  A9 0F                lda #$0f
000014r 1  8D 0E 90             sta VIC_VOLUME
000017r 1  A9 C8                lda #200
000019r 1                       ;lda #130
000019r 1  8D 0A 90             sta VIC_BASS
00001Cr 1                       ;lda #148
00001Cr 1                       ;sta VIC_ALTO
00001Cr 1                       ;lda #220
00001Cr 1  8D 0D 90             sta VIC_NOISE
00001Fr 1  A9 08                lda #8
000021r 1  85 rr                sta sfx_dur
000023r 1  60                   rts
000024r 1               
000024r 1               play_audio_frame:
000024r 1  A5 rr                lda sfx_dur
000026r 1  F0 07                beq :+
000028r 1  C6 rr                dec sfx_dur
00002Ar 1  D0 03                bne :+
00002Cr 1  4C rr rr             jmp silence_vic
00002Fr 1               :
00002Fr 1  60                   rts
000030r 1               
000030r 1               .segment "CODE2"
000000r 1               
000000r 1               play_hurt:
000000r 1  A9 8C                lda #140
000002r 1  8D 0A 90             sta VIC_BASS
000005r 1  A9 9B                lda #155
000007r 1  8D 0B 90             sta VIC_ALTO
00000Ar 1  A9 0F                lda #$0f
00000Cr 1  8D 0E 90             sta VIC_VOLUME
00000Fr 1  A9 C8                lda #200
000011r 1  8D 0D 90             sta VIC_NOISE
000014r 1  A9 08                lda #8
000016r 1  85 rr                sta sfx_dur
000018r 1  60                   rts
000018r 1               
